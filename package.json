{
  "name": "open-health",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "dev:web": "turbo dev --filter=@open-health/web",
    "build": "turbo build --filter=@open-health/web",
    "start": "cd apps/web && npm start",
    "lint": "turbo lint",
    "test": "turbo test",
    "test:watch": "vitest",
    "test:integration": "vitest run --config apps/web/vitest.integration.config.ts",
    "dev:worker": "cd apps/worker && pnpm dev",
    "db:generate": "cd packages/db && source ../../apps/web/.env.local && DATABASE_URL=$DATABASE_URL pnpm db:generate",
    "test:e2e": "cd apps/web && pnpm test:e2e"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.1",
    "@types/node": "^22.19.13",
    "turbo": "^2.5.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "packageManager": "pnpm@10.11.0",
  "dependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/core": "^8.5.1"
  }
}
